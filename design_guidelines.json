      "forklift": "https://images.unsplash.com/photo-1740914994154-c3273e113336?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NDk1NzZ8MHwxfHNlYXJjaHwzfHx3YXJlaG91c2UlMjBsb2dpc3RpY3MlMjB3b3JrZXJ8ZW58MHx8fHwxNzY3NzkyNTUxfDA&ixlib=rb-4.1.0&q=85",
      "business_portrait_female": "https://images.unsplash.com/photo-1758518727592-706e80ebc354?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NDk1Nzh8MHwxfHNlYXJjaHw0fHxwcm9mZXNzaW9uYWwlMjBidXNpbmVzcyUyMHBvcnRyYWl0fGVufDB8fHx8MTc2Nzc4NDUwNnww&ixlib=rb-4.1.0&q=85",
      "business_portrait_male": "https://images.unsplash.com/photo-1629507208649-70919ca33793?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NDk1Nzh8MHwxfHNlYXJjaHwyfHxwcm9mZXNzaW9uYWwlMjBidXNpbmVzcyUyMHBvcnRyYWl0fGVufDB8fHx8MTc2Nzc4NDUwNnww&ixlib=rb-4.1.0&q=85"
