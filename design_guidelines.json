  },
  "instructions_to_main_agent": [
    "Use 'Manrope' for all headings and 'IBM Plex Sans' for body text. Import them via Google Fonts in index.css.",
    "Implement the 'Control Room Grid' for the dashboard: dense, data-heavy, minimal gaps.",
    "Use the provided OLL logo in the top-left of the sidebar/header.",
    "Strictly follow the color palette. Do NOT use the forbidden Teal color.",
    "Ensure all interactive elements have 'data-testid' attributes.",
    "Use Shadcn components for all complex interactions (Datepicker, Select, Dialog, etc.) but customize them to match the 'Sharp/Clean' aesthetic.",
    "For the 'Public Tracking Page', use a simplified layout without the sidebar, focusing on the timeline and status.",
    "Use 'sonner' for all toast notifications.",
    "Ensure high contrast for text. Text on white backgrounds must be Slate-600 or darker.",
    "Do NOT use gradients for backgrounds. Keep it flat and clean."
  ],
  "universal_guidelines": [
    "Avoid 'AI slop' - no generic centered layouts.",
    "Use 2-3x more spacing than typical designs.",
    "Every interaction needs micro-animations.",
    "Never use AI assistant Emoji characters.",
    "Dark colors look good when used independently without gradients."
  ]
}